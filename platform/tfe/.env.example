COMPOSE_PROJECT_NAME=tfe-load-testing

# Current demo image tag is the latest ARM-capable Terraform Enterprise release line.
# HashiCorp publishes both amd64 and arm64 variants for this tag.
TFE_IMAGE=images.releases.hashicorp.com/hashicorp/terraform-enterprise:1.0.3
TFE_LICENSE=replace-with-your-tfe-license
TFE_HOSTNAME=tfe.localdemo.me
# Default host port for HTTPS is 443. On Podman machine, run
# `make podman-machine-allow-443` if the machine still blocks privileged host
# ports. If you cannot change the machine setting, use an unprivileged fallback
# such as 8443 instead.
TFE_HTTPS_PORT=443
TFE_ENCRYPTION_PASSWORD=replace-with-a-strong-demo-password
TFE_TOKEN=replace-with-your-tfe-user-or-team-token
TFE_IACT_SUBNETS=10.88.0.0/16,127.0.0.1/32
# Maximum number of concurrent Terraform runs that TFE will execute simultaneously
# If not set, TFE uses its internal default (typically 10 based on available CPU cores)
# Higher values allow more parallel runs but require more CPU/memory resources
# Recommended: 10 (light load), 20 (medium load), 50+ (high load with adequate resources)
# TFE_CAPACITY_CONCURRENCY=10
# Podman host alias that lets the main TFE container and run-pipeline containers
# reach https://${TFE_HOSTNAME} without resolving it to 127.0.0.1 inside the container.
#
# IMPORTANT: This must be set correctly for CLI-driven runs to work.
#
# To find the correct value:
# - On macOS with Podman machine: 192.168.127.254 (host.containers.internal)
# - On Linux with default bridge: 10.88.0.1 (podman0 gateway)
#
# To verify/discover the correct IP:
#   macOS: podman machine ssh "ip addr show eth0 | grep 'inet ' | awk '{print \$2}' | cut -d/ -f1"
#   Linux: podman network inspect podman --format '{{(index .Subnets 0).Gateway}}'
#
# Symptom of incorrect value: Archivist callbacks fail with connection errors
TFE_HOST_ALIAS_IP=192.168.127.254
# Linux example: /tmp/podman.sock from `podman system service --time=0 unix:///tmp/podman.sock`
# macOS Podman machine: use the rootful machine connection for TFE, then run
# `make podman-socket` and replace the value below with the detected guest-side socket.
# The rootful machine connection typically uses /run/podman/podman.sock. Rootless
# Podman cannot grant the memlock limit that TFE's bundled Vault needs at boot.
# If you switch Podman connections, rerun `make podman-socket`.
PODMAN_SOCKET=/tmp/podman.sock

TFE_DATABASE_USER=postgres
TFE_DATABASE_PASSWORD=postgres
TFE_DATABASE_NAME=tfe
TFE_DATABASE_PARAMETERS=sslmode=disable

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
TFE_OBJECT_STORAGE_S3_REGION=us-east-1
TFE_OBJECT_STORAGE_S3_BUCKET=tfe-state

# Monitoring Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
TFE_TOKEN=replace-with-your-tfe-user-or-team-token
TFE_ORGANIZATION=replace-with-your-organization-name
