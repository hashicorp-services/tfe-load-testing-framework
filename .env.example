# TFE Load Testing Framework - Environment Configuration
# Copy this file to .env and fill in your values
# Then run: source .env

# Required: TFE API Token
# Generate this in your TFE instance: Settings > Tokens
TFE_TOKEN=your-tfe-api-token-here

# Required: TFE Organization Name
TFE_ORGANIZATION=your-organization-name

# Optional: TFE Hostname (default: tfe.localdemo.me)
# For TFE Cloud, use: app.terraform.io
# For local dev, use: tfe.localdemo.me
TFE_HOSTNAME=tfe.localdemo.me

# Optional: SSL Verification (default: true)
# Set to false for local development with self-signed certificates
TFE_VERIFY_SSL=false

# Optional: Cleanup workspaces after tests (default: true)
CLEANUP_WORKSPACES=true

# Optional: Grafana Configuration (for metrics collection)
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Load Test Configuration (can be overridden via command-line)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2
LOCUST_RUN_TIME=5m
LOCUST_WEB_HOST=0.0.0.0
LOCUST_WEB_PORT=8089

# Optional: Sentinel policy profile for examples/run_sentinel_policy_test.sh
# standard: small pass/fail sample policies
# synthetic-heavy: adds a repeated plan-scan policy for local policy-stage calibration
# Use custom policy sets with representative policies for customer benchmarking.
TFE_SENTINEL_POLICY_PROFILE=synthetic-heavy
TFE_SENTINEL_SYNTHETIC_RESOURCE_COUNT=150
TFE_SENTINEL_HEAVY_POLICY_SCAN_COUNT=80

# Optional: Logging (default: INFO)
LOG_LEVEL=INFO
