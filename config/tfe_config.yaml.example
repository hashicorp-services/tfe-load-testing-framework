# TFE Load Testing Configuration Template
#
# Copy this file to tfe_config.yaml and update with your TFE instance details.
# DO NOT commit tfe_config.yaml to version control - it contains sensitive data.

# TFE Instance Configuration
tfe:
  # TFE hostname (without https://)
  # Examples:
  #   - app.terraform.io (for Terraform Cloud)
  #   - tfe.example.com (for self-hosted TFE)
  #   - tfe.localdemo.me (for local development)
  hostname: "tfe.localdemo.me"
  
  # TFE API token
  # Generate from: User Settings > Tokens or Team Settings > Tokens
  # Can also be set via TFE_TOKEN environment variable
  token: "${TFE_TOKEN}"
  
  # Default organization name
  # Can also be set via TFE_ORGANIZATION environment variable
  organization: "my-org"
  
  # SSL certificate verification
  # Set to false for self-signed certificates (local development)
  verify_ssl: false
  
  # Request timeout in seconds
  timeout: 30
  
  # Maximum retries for failed requests
  max_retries: 3

# Load Test Configuration
load_test:
  # SIMPLIFIED APPROACH: Use max_concurrent_runs as the primary parameter
  # This controls the number of users/workspaces created for the test
  # Each user creates one workspace and can trigger multiple runs on it
  # TFE naturally manages the run queue based on its capacity
  # 
  # The number of Locust users and spawn rate are automatically calculated:
  # Formula: users = max(5, max_concurrent_runs)
  # Formula: spawn_rate = max_concurrent_runs (instant spawn)
  # Example: max_concurrent_runs=20 → 20 users, 20 workspaces, 20/s spawn rate
  max_concurrent_runs: 20
  
  # Advanced: Override automatic calculations (optional)
  # Leave commented to use automatic calculation
  # spawn_rate: 2
  
  # Test duration (examples: "5m", "1h", "30s")
  # Leave empty for manual stop
  run_time: "5m"
  
  # Advanced: Override automatic user calculation (optional)
  # Leave commented to use automatic calculation
  # users: 10
  
  # Web UI configuration
  web_ui:
    # Host for Locust web interface
    host: "0.0.0.0"
    
    # Port for Locust web interface
    port: 8089
  
  # Cleanup configuration
  cleanup:
    # Whether to delete created resources after test
    enabled: true
    
    # Whether to cleanup on test failure
    cleanup_on_failure: false

# Scenario-Specific Configuration
scenarios:
  # Workspace Operations Scenario
  workspace_operations:
    # Task weights (higher = more frequent)
    task_weights:
      create_workspace: 10
      list_workspaces: 5
      get_workspace_details: 3
      delete_workspace: 2
    
    # Wait time between tasks (seconds)
    wait_time:
      min: 2
      max: 5
    
    # Workspace naming pattern
    workspace_prefix: "loadtest"
  
  # Configuration Upload Scenario (future)
  configuration_upload:
    # Configuration file sizes to test
    config_sizes:
      - small: "1KB"
      - medium: "100KB"
      - large: "10MB"
    
    # Auto-queue runs after upload
    auto_queue_runs: false
  
  # Run Operations Scenario
  run_operations:
    # Run timeout in seconds
    run_timeout: 300
    
    # Polling interval in seconds
    poll_interval: 10
    
    # Auto-apply runs
    auto_apply: false
  
  # Sentinel Policy Evaluation Scenario
  sentinel_policies:
    # Enable Sentinel policy testing
    enabled: false
    
    # Policy set name to use for testing.
    # Default sample policy sets are auto-created/reused by the sentinel script.
    # Custom policy set names must already exist in TFE.
    policy_set_name: "loadtest-policies-synthetic-heavy"

    # Policy profile for auto-created local policy sets:
    # - standard: advisory, soft-mandatory, hard-mandatory sample policies
    # - synthetic-heavy: standard policies plus a repeated plan-scan policy for local policy-stage calibration
    policy_profile: "synthetic-heavy"
    # Synthetic-heavy tuning:
    # - synthetic_resource_count controls Terraform plan size (max: 500)
    # - heavy_policy_scan_count controls repeated Sentinel plan scans (max: 250)
    synthetic_resource_count: 150
    heavy_policy_scan_count: 80
    
    # Policy enforcement levels to test
    enforcement_levels:
      - advisory    # Warnings only, runs can proceed
      - soft-mandatory  # Can be overridden
      - hard-mandatory  # Cannot be overridden
    
    # Test policy outcomes
    test_outcomes:
      - pass      # Policies that should pass
      - fail      # Policies that should fail
      - override  # Test policy override workflow
    
    # Wait time for policy checks (seconds)
    policy_check_timeout: 120
    
    # Polling interval for policy check status (seconds)
    policy_check_poll_interval: 5

# Monitoring Configuration
monitoring:
  # Enable Prometheus metrics export
  prometheus_enabled: true
  
  # Prometheus metrics port
  prometheus_port: 9646
  
  # Custom metrics to track
  custom_metrics:
    - workspace_creation_time
    - run_queue_depth
    - api_error_rate

# Logging Configuration
logging:
  # Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  level: "INFO"
  
  # Log format
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  
  # Log to file
  file:
    enabled: true
    path: "logs/tfe_load_test.log"
    max_bytes: 10485760  # 10MB
    backup_count: 5
  
  # Log to console
  console:
    enabled: true
    colored: true

# Reporting Configuration
reporting:
  # Generate HTML report
  html_report:
    enabled: true
    path: "reports/load_test_report.html"
  
  # Generate CSV report
  csv_report:
    enabled: true
    path: "reports/load_test_stats.csv"
  
  # Include charts in report
  include_charts: true
  
  # Report title
  title: "TFE Load Test Report"

# Advanced Configuration
advanced:
  # Connection pool size
  connection_pool_size: 10
  
  # Enable request/response logging (verbose)
  debug_requests: false
  
  # Custom headers to include in all requests
  custom_headers: {}
  
  # Proxy configuration (if needed)
  proxy:
    enabled: false
    http: ""
    https: ""
